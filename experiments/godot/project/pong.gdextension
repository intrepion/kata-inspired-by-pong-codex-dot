[configuration]
entry_symbol="gdext_rust_init"
compatibility_minimum="4.5"
reloadable=true
[libraries]
macos.debug.arm64="res://bin/libpong_godot.dylib"
macos.release.arm64="res://bin/libpong_godot.dylib"
macos.debug.x86_64="res://bin/libpong_godot.dylib"
macos.release.x86_64="res://bin/libpong_godot.dylib"
windows.debug.x86_64="res://bin/pong_godot.dll"
windows.release.x86_64="res://bin/pong_godot.dll"
linux.debug.x86_64="res://bin/libpong_godot.so"
linux.release.x86_64="res://bin/libpong_godot.so"
linux.debug.arm64="res://bin/libpong_godot.so"
linux.release.arm64="res://bin/libpong_godot.so"

struct State { positions:vec4<f32>, viewport_scores:vec4<f32> }
@group(0) @binding(0) var<uniform> state:State;
@vertex fn vs_main(@builtin(vertex_index) i:u32)->@builtin(position) vec4<f32>{var p=array<vec2<f32>,3>(vec2(-1.,-1.),vec2(3.,-1.),vec2(-1.,3.));return vec4(p[i],0.,1.);}
@fragment fn fs_main(@builtin(position) pixel:vec4<f32>)->@location(0) vec4<f32>{let size=state.viewport_scores.xy;let scale=min(size.x/900.,size.y/500.);let p=(pixel.xy-(size-vec2(900.,500.)*scale)*0.5)/scale;var c=vec3(0.025,0.04,0.09);if any(p<vec2(0.))||any(p>vec2(900.,500.)){return vec4(0.,0.,0.,1.);}if abs(p.x-450.)<1. && (u32(p.y)%25u)<12u {c=vec3(0.18,0.25,0.35);}if (abs(p.x-38.)<6.&&abs(p.y-state.positions.x)<45.)||(abs(p.x-862.)<6.&&abs(p.y-state.positions.y)<45.){c=vec3(0.35,0.95,0.85);}if distance(p,state.positions.zw)<8.{c=vec3(1.);}for(var side=0u;side<2u;side++){let score=select(state.viewport_scores.z,state.viewport_scores.w,side==1u);for(var j=0u;j<u32(score);j++){let x=450.+(f32(side)*2.-1.)*(30.+f32(j)*16.);if abs(p.x-x)<4.&&abs(p.y-24.)<8.{c=vec3(1.);}}}return vec4(c,1.);}
